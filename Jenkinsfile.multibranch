properties([
  pipelineTriggers([githubPush()]),
  disableConcurrentBuilds()
])

pipeline {
  agent any

  environment {
    CI = 'true'
    TEST_ENV = 'qa'
    NODE_ENV = 'test'
    IMAGE_NAME = 'orangehrm-playwright'
    DOCKER_TAG = "${env.BRANCH_NAME ?: 'branch'}-${env.BUILD_NUMBER ?: 'local'}"
    SLACK_CHANNEL = 'ci-builds'
  }

  options {
    timestamps()
    timeout(time: 75, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
    skipDefaultCheckout(false)
  }

  stages {
    stage('Checkout') {
      steps {
        echo "Branch: ${env.BRANCH_NAME}"
        checkout scm
      }
    }

    stage('Build Docker image') {
      steps {
        sh 'docker build -t ${IMAGE_NAME}:${DOCKER_TAG} -f Dockerfile .'
      }
    }

    stage('Run UI tests') {
      steps {
        sh '''
          mkdir -p allure-results playwright-report test-results
          docker run --rm \
            -e CI=true \
            -e TEST_ENV=qa \
            -e NODE_ENV=test \
            -v "$PWD/allure-results:/app/allure-results" \
            -v "$PWD/playwright-report:/app/playwright-report" \
            -v "$PWD/test-results:/app/test-results" \
            ${IMAGE_NAME}:${DOCKER_TAG} \
            npx playwright test tests/ui --reporter=line,allure-playwright
        '''
      }
    }

    stage('Run API tests') {
      steps {
        sh '''
          docker run --rm \
            -e CI=true \
            -e TEST_ENV=qa \
            -e NODE_ENV=test \
            -v "$PWD/allure-results:/app/allure-results" \
            -v "$PWD/playwright-report:/app/playwright-report" \
            -v "$PWD/test-results:/app/test-results" \
            ${IMAGE_NAME}:${DOCKER_TAG} \
            npx playwright test tests/api --reporter=line,allure-playwright
        '''
      }
    }

    stage('Generate Allure report') {
      steps {
        sh 'npx allure generate allure-results --clean -o allure-report || true'
      }
    }
  }

  post {
    always {
      publishHTML(target: [
        allowMissing: true,
        alwaysLinkToLastBuild: true,
        keepAll: true,
        reportDir: 'playwright-report',
        reportFiles: 'index.html',
        reportName: 'Playwright HTML Report'
      ])

      publishHTML(target: [
        allowMissing: true,
        alwaysLinkToLastBuild: true,
        keepAll: true,
        reportDir: 'allure-report',
        reportFiles: 'index.html',
        reportName: 'Allure Report'
      ])

      archiveArtifacts(
        artifacts: 'playwright-report/**, allure-report/**, allure-results/**, test-results/**, tmp-storage.json',
        allowEmptyArchive: true,
        fingerprint: true
      )
    }

    success {
      slackSend(
        channel: env.SLACK_CHANNEL,
        color: '#36a64f',
        message: "SUCCESS: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BRANCH_NAME})"
      )
    }

    failure {
      slackSend(
        channel: env.SLACK_CHANNEL,
        color: '#d00000',
        message: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (${env.BRANCH_NAME})"
      )
    }
  }
}
